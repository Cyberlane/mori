{
  "profile": "review",
  "threshold": 0.85,
  "min_tokens": 40,
  "max_groups": 1000,
  "max_occurrences": 10,
  "format": "text",
  "comparison_domain": "code",
  "ranking": "review",
  "same_language_only": true,
  "require_coverage": true,
  "min_file_coverage": 0.9,
  "max_zero_fragment_files": 5,
  "fail_on_warning": true,
  "exclude_generated": true,
  "exclude": ["**/*_test.go", "examples/**"],
  "respect_ignore": true
}
