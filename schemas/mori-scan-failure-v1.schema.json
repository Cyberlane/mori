{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Cyberlane/mori/main/schemas/mori-scan-failure-v1.schema.json",
  "title": "Mori incomplete scan failure artifact 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "failure_schema_version",
    "complete",
    "reason",
    "message",
    "limit",
    "compared_pairs",
    "tool",
    "configuration",
    "coverage",
    "file_coverage",
    "warnings",
    "recovery",
    "requested_paths"
  ],
  "properties": {
    "artifact": {
      "const": "mori-scan-failure"
    },
    "failure_schema_version": {
      "const": 1
    },
    "complete": {
      "const": false
    },
    "reason": {
      "const": "candidate_pair_limit"
    },
    "message": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "compared_pairs": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "file_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileCoverage"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requested_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision",
        "source_date",
        "modified",
        "go_version",
        "goos",
        "goarch",
        "normalization_version"
      ],
      "properties": {
        "name": {
          "const": "mori"
        },
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "source_date": {
          "type": "string"
        },
        "modified": {
          "type": "boolean"
        },
        "go_version": {
          "type": "string"
        },
        "goos": {
          "type": "string"
        },
        "goarch": {
          "type": "string"
        },
        "normalization_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_kind",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "node_kind": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "baseline",
            "coverage",
            "focus",
            "other",
            "parse"
          ]
        },
        "path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "total_diagnostics": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "skipped_fragments": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "fileCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "language",
        "language_family",
        "comparison_domain",
        "status",
        "generated",
        "fragment_count",
        "candidate_fragment_count",
        "below_token_floor_count",
        "skipped_fragments",
        "parse_diagnostics",
        "excluded_test_fragment_count",
        "excluded_production_fragment_count"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "language_family": {
          "type": "string"
        },
        "comparison_domain": {
          "enum": [
            "code",
            "sql-query"
          ]
        },
        "status": {
          "enum": [
            "analyzed",
            "excluded_generated",
            "skipped_resource"
          ]
        },
        "generated": {
          "type": "boolean"
        },
        "generated_marker": {
          "type": "string"
        },
        "fragment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "candidate_fragment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "below_token_floor_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "zero_fragment_reason": {
          "enum": [
            "no_boundaries",
            "below_token_floor",
            "invalid_fragments",
            "resource_limit",
            "generated_excluded",
            "fragment_selection",
            "opaque_syntax"
          ]
        },
        "skipped_fragments": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "parse_diagnostics": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "excluded_test_fragment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "excluded_production_fragment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "file_count"
      ],
      "properties": {
        "extension": {
          "type": "string"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_files",
        "analyzed_files",
        "fragment_files",
        "zero_fragment_files",
        "generated_excluded_files",
        "warning_files",
        "warning_count",
        "parse_diagnostic_files",
        "parse_diagnostic_count",
        "unsupported_extensions"
      ],
      "properties": {
        "supported_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "analyzed_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "fragment_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "zero_fragment_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "generated_excluded_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "parse_diagnostic_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "parse_diagnostic_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "unsupported_extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unsupported"
          }
        }
      }
    },
    "ignoreEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "priorityPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "priority"
      ],
      "properties": {
        "pattern": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "worktreeFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "requested_base",
        "base_commit",
        "merge_base",
        "head_commit",
        "working_tree_included",
        "untracked_included",
        "changed_paths",
        "deleted_paths"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "requested_base": {
          "type": "string"
        },
        "base_commit": {
          "type": "string"
        },
        "merge_base": {
          "type": "string"
        },
        "head_commit": {
          "type": "string"
        },
        "working_tree_included": {
          "type": "boolean"
        },
        "untracked_included": {
          "type": "boolean"
        },
        "changed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "deleted_paths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "explicit_paths",
        "working_tree_included",
        "untracked_included",
        "changed_paths",
        "deleted_paths",
        "discovered_focus_files",
        "required_focus_files",
        "covered_focus_files",
        "path_evidence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "explicit",
            "git",
            "git-and-explicit",
            "git-worktrees",
            "git-worktrees-and-explicit",
            "git-index",
            "git-index-and-explicit"
          ]
        },
        "explicit_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "requested_base": {
          "type": "string"
        },
        "base_commit": {
          "type": "string"
        },
        "merge_base": {
          "type": "string"
        },
        "head_commit": {
          "type": "string"
        },
        "index_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "working_tree_included": {
          "type": "boolean"
        },
        "untracked_included": {
          "type": "boolean"
        },
        "changed_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "deleted_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktreeFocus"
          }
        },
        "discovered_focus_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "required_focus_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "covered_focus_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "path_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/focusPathEvidence"
          }
        }
      }
    },
    "focusPathEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "analyzed",
            "deleted",
            "excluded_generated",
            "skipped_resource",
            "unsupported",
            "not_discovered"
          ]
        },
        "changed_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineInterval"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "lineInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "working_tree_included",
        "untracked_included"
      ],
      "properties": {
        "mode": {
          "const": "git-index"
        },
        "git_root": {
          "type": "string"
        },
        "head_commit": {
          "type": "string"
        },
        "index_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "working_tree_included": {
          "const": false
        },
        "untracked_included": {
          "const": false
        }
      }
    },
    "reviewReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schema_version",
        "digest",
        "focused_match_groups"
      ],
      "properties": {
        "status": {
          "const": "compatible"
        },
        "schema_version": {
          "const": 2
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "focused_match_groups": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ignore_files",
        "ignore_file_evidence",
        "respect_ignore",
        "exclude_generated",
        "excludes",
        "min_tokens",
        "max_groups",
        "max_occurrences",
        "max_pairs",
        "max_file_bytes",
        "comparison_domain",
        "sql_dialect",
        "embedded_sql",
        "statement_blocks",
        "block_statements",
        "max_blocks_per_function",
        "ranking",
        "priority_paths",
        "same_language_only",
        "cross_language_only",
        "language_pairs",
        "require_coverage",
        "min_file_coverage",
        "max_zero_fragment_files",
        "fail_on_warning",
        "fail_on_parse_diagnostic",
        "focused_only",
        "scan_profile_digest"
      ],
      "properties": {
        "profile": {
          "enum": [
            "review",
            "explore",
            "sql"
          ]
        },
        "scope": {
          "type": "string"
        },
        "scope_roots": {
          "$ref": "#/$defs/stringArray"
        },
        "config_path": {
          "type": "string"
        },
        "ignore_files": {
          "$ref": "#/$defs/stringArray"
        },
        "ignore_file_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ignoreEvidence"
          }
        },
        "respect_ignore": {
          "type": "boolean"
        },
        "exclude_generated": {
          "type": "boolean"
        },
        "excludes": {
          "$ref": "#/$defs/stringArray"
        },
        "min_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_groups": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "max_occurrences": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "max_pairs": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "max_file_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comparison_domain": {
          "type": "string"
        },
        "sql_dialect": {
          "enum": [
            "generic",
            "postgresql"
          ]
        },
        "embedded_sql": {
          "type": "boolean"
        },
        "statement_blocks": {
          "type": "boolean"
        },
        "block_statements": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "max_blocks_per_function": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "ranking": {
          "enum": [
            "structural",
            "review"
          ]
        },
        "priority_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/priorityPath"
          }
        },
        "same_language_only": {
          "type": "boolean"
        },
        "cross_language_only": {
          "type": "boolean"
        },
        "language_pairs": {
          "$ref": "#/$defs/stringArray"
        },
        "require_coverage": {
          "type": "boolean"
        },
        "min_file_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_zero_fragment_files": {
          "type": "integer",
          "minimum": -1
        },
        "fail_on_warning": {
          "type": "boolean"
        },
        "fail_on_parse_diagnostic": {
          "type": "boolean"
        },
        "focused_only": {
          "type": "boolean"
        },
        "baseline_path": {
          "type": "string"
        },
        "scan_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_profile_status": {
          "enum": [
            "compatible",
            "legacy"
          ]
        },
        "stdin_path": {
          "type": "string"
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "input": {
          "$ref": "#/$defs/inputSnapshot"
        },
        "review_receipt": {
          "$ref": "#/$defs/reviewReceipt"
        },
        "fragment_selection": {
          "type": "string",
          "enum": [
            "all",
            "production",
            "tests"
          ]
        },
        "production_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
